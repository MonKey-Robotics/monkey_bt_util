<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="main">
    <Fallback name="root_fallback">
      <Sequence name="hand_harvest">
        <Fallback name="frond_found_fallback">
          <FrondFound name="frond_found"/>
          <FindFrond name="find_ball"/>
        </Fallback>
        <Fallback name="near_frond_fallback">
          <NearFrond name="near_frond"/>
          <OpenShear name="open_shear"/>
          <ApproachFrond name="approach_frond"/>
        </Fallback>
        <Fallback name="frond_reached_fallback">
          <FrondReached name="frond_reached"/>
          <CloseShear name="close_shear"/>
        </Fallback>
        <Fallback name="hold_up_fallback">
          <ReturnHoldup name="return_hold_up"/>
          <HoldUp name="hold_up"/>
        </Fallback>
      </Sequence>
      <!-- <RecoveryNode number_of_retries="5">
        <ForceFailure>
          <LogInfo message="This will always fail!"/>
        </ForceFailure>
        <LogInfo message="Running recovery action"/>
      </RecoveryNode> -->
      <Recovery name="Recovery">
    </Fallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ApproachFrond"
            editable="true"/>
    <Action ID="CloseShear"
            editable="true"/>
    <Action ID="FindFrond"
            editable="true"/>
    <Condition ID="FrondFound"
               editable="true"/>
    <Condition ID="FrondReached"
               editable="true"/>
    <Action ID="HoldUp"
            editable="true"/>
    <Action ID="LogInfo"
            editable="true">
      <input_port name="message"/>
    </Action>
    <Condition ID="NearFrond"
               editable="true"/>
    <Action ID="OpenShear"
            editable="true"/>
    <Control ID="RecoveryNode"
             editable="true">
      <input_port name="number_of_retries"
                  default="1"/>
    </Control>
    <Condition ID="ReturnHoldup"
               editable="true"/>
  </TreeNodesModel>

</root>
